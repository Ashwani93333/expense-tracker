# ------------------------------------------------------------------
# Expense Tracker — environment variables (copy to .env or set in your
# shell / IDE). Every value here maps to a placeholder in application.yml.
# DO NOT commit a real .env file with actual secrets.
# ------------------------------------------------------------------

# --- Database (PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/expense-tracker
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT ---
# 256-bit (32-byte) hex secret. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-hex-secret
# Token lifetime in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000

# --- Gemini AI (receipt OCR + AI category guess) ---
GEMINI_API_KEY=

# --- SMTP (notification + invite emails) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_SMTP_CONNECTION_TIMEOUT=10000
MAIL_SMTP_TIMEOUT=10000
MAIL_SMTP_WRITE_TIMEOUT=10000

# --- App ---
# Base URL of the frontend, used to build invite links and email CTA URLs
APP_FRONTEND_BASE_URL=http://localhost:5173
# "From" header for outgoing mail (name/address)
APP_MAIL_FROM=no-reply@example.com
APP_MAIL_FROM_NAME=Expense Tracker

# --- Classification ---
CLASSIFICATION_AUTO_ASSIGN_THRESHOLD=0.75
CLASSIFICATION_WARN_THRESHOLD=0.50
CLASSIFICATION_FALLBACK_CATEGORY=Uncategorized

# --- Scheduler ---
# Cron for the monthly summary email (default: 1st of month at 02:00)
MONTHLY_SUMMARY_CRON=0 0 2 1 * *
