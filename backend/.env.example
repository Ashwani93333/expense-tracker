# ------------------------------------------------------------------
# Expense Tracker — environment variables (copy to .env or set in your
# shell / IDE / container platform). Every value here maps to a
# placeholder in application.yml.
# DO NOT commit a real .env file with actual secrets.
# ------------------------------------------------------------------

# --- Profile ---
# Use "prod" in production, "dev" locally.
SPRING_PROFILES_ACTIVE=dev

# --- Database (PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/expense-tracker
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
# Prod-only Hikari tuning (optional)
# DB_POOL_MAX_SIZE=10
# DB_POOL_MIN_IDLE=2
# JPA_DDL_AUTO=update

# --- JWT ---
# 256-bit (32-byte) minimum secret. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-hex-secret
# Token lifetime in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000

# --- Gemini AI (receipt OCR + AI category guess) ---
GEMINI_API_KEY=
# Optional: override the model (defaults to gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- SMTP (notification + invite emails) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_SMTP_CONNECTION_TIMEOUT=10000
MAIL_SMTP_TIMEOUT=10000
MAIL_SMTP_WRITE_TIMEOUT=10000

# --- App ---
# Base URL of the frontend, used to build invite links and email CTA URLs
APP_FRONTEND_BASE_URL=http://localhost:5173
# Comma-separated CORS allow-list for the frontend origin(s)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# "From" header for outgoing mail (name/address)
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Expense Tracker
# Directory for uploaded receipt images (mount a volume here in prod)
APP_STORAGE_LOCATION=uploads
# Upload size limits (Spring multipart)
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# --- Cache (Caffeine, in-process) ---
APP_CACHE_ENABLED=true
APP_CACHE_TTL_SECONDS=30
APP_CACHE_MAX_ENTRIES=1000

# --- Classification ---
CLASSIFICATION_AUTO_ASSIGN_THRESHOLD=0.75
CLASSIFICATION_WARN_THRESHOLD=0.50
CLASSIFICATION_FALLBACK_CATEGORY=Uncategorized

# --- Scheduler ---
# Cron for the monthly summary email (default: 1st of month at 02:00)
MONTHLY_SUMMARY_CRON=0 0 2 1 * *
